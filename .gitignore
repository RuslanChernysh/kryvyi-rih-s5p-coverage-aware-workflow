# Earth Engine / local working exports
exports/
output/
outputs/
tmp/
temp/

# Large raster products are ignored by default
*.tif
*.tiff

# Scientific GeoTIFFs intentionally archived in the
# publication reproducibility package are tracked
!data/rasters/
!data/rasters/*.tif
!data/rasters/*.tiff
